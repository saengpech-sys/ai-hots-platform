rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write to own student + teacher profiles via server-side gating in app
    match /students/{userId} {
  // Owners can read/write their own profile; teachers can read student profiles
  allow read: if request.auth != null && (request.auth.uid == userId || isTeacherUser());
  allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /teachers/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Assessments: readable to authenticated; writes allowed to scenario owner or teacher-of-course
    match /assessments/{assessmentId} {
      // Allow any authenticated user to read assessments (rubrics/tasks are not sensitive)
      allow read: if request.auth != null;

      // Allow create when the requester either owns the scenario or is the teacher of the course
      allow create: if request.auth != null && (
        // Owner of the scenario (general/legacy)
        get(/databases/$(database)/documents/scenarios/$(request.resource.data.scenarioId_ref)).data.studentId_ref == request.auth.uid ||
        // Teacher of the course provided on assessment
        isTeacherOfCourse(request.resource.data.courseId_ref) ||
        // Or teacher of the course inferred from the linked scenario
        isTeacherOfCourse(get(/databases/$(database)/documents/scenarios/$(request.resource.data.scenarioId_ref)).data.courseId_ref)
      );

      // Allow update/delete with the same ownership/teacher-of-course semantics
      allow update, delete: if request.auth != null && (
        get(/databases/$(database)/documents/scenarios/$(resource.data.scenarioId_ref)).data.studentId_ref == request.auth.uid ||
        isTeacherOfCourse(resource.data.courseId_ref) ||
        isTeacherOfCourse(get(/databases/$(database)/documents/scenarios/$(resource.data.scenarioId_ref)).data.courseId_ref)
      );
    }

    // Courses are readable to authenticated users; write limited to owner teacher
    match /courses/{courseId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && resource.data.teacherId == request.auth.uid;
      allow create: if request.auth != null;
    }

    // Submissions: owner-student can read/write their own; teacher of the course can read
    match /submissions/{submissionId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.studentId_ref;
      allow read, update, delete: if request.auth != null && (
        request.auth.uid == resource.data.studentId_ref ||
        isTeacherOfCourse(resource.data.courseId_ref) ||
        // Legacy: allow via mission -> course
        (
          resource.data.missionId_ref != null &&
          isTeacherOfCourse(get(/databases/$(database)/documents/missions/$(resource.data.missionId_ref)).data.courseId_ref)
        ) ||
        // Legacy: allow via scenario -> course
        (
          resource.data.scenarioId_ref != null &&
          isTeacherOfCourse(get(/databases/$(database)/documents/scenarios/$(resource.data.scenarioId_ref)).data.courseId_ref)
        )
      );
    }

    // Missions and scenarios: readable to authenticated; writes restricted to owners
    match /missions/{missionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == resource.data.studentId_ref ||
        isTeacherOfCourse(resource.data.courseId_ref)
      );
    }
    match /scenarios/{scenarioId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == resource.data.studentId_ref ||
        isTeacherOfCourse(resource.data.courseId_ref)
      );
    }

    // Governance / privacy related collections (server-only writes)
    match /audit_logs/{id} {
      // Never readable client-side (could contain sensitive events)
      allow read, write: if false;
    }
    match /delete_requests/{uid} {
      // User can read their own delete request document; admins can read any
      allow read: if request.auth != null && (request.auth.uid == uid || isAdminClaim());
      // Creation/updates only via Cloud Functions (disallow direct)
      allow write: if false;
    }
    // Explicitly disallow client reads of admins list (use Cloud Functions for gating)
    match /admins/{uid} {
      allow read, write: if false;
    }
    match /parental_consents/{id} {
      // Parental consent submitted via HTTPS function; disallow direct access
      allow read, write: if false;
    }
    match /dpia_records/{id} {
      // Teachers can read their own records; creation goes through function to enforce validation
      allow read: if request.auth != null && get(/databases/$(database)/documents/dpia_records/$(id)).data.createdBy == request.auth.uid;
      allow write: if false;
    }

    // Mini-lessons: teacher-private by default
    match /mini_lessons/{id} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.teacherId_ref;
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.teacherId_ref;
    }

    function isTeacherOfCourse(courseId) {
      return exists(/databases/$(database)/documents/courses/$(courseId)) &&
        get(/databases/$(database)/documents/courses/$(courseId)).data.teacherId == request.auth.uid;
    }

    function isTeacherUser() {
      // A user is considered a teacher if:
      // 1) There is any document in teachers/{uid}, OR
      // 2) Their students/{uid} profile has role == 'teacher'
      return exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) || (
        exists(/databases/$(database)/documents/students/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/students/$(request.auth.uid)).data.role == 'teacher'
      );
    }
    function isAdminClaim() {
      return request.auth.token.admin == true;
    }
  }
}
