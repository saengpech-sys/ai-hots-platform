rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Student avatars stored under student-avatars/{uid}/...
    match /student-avatars/{userId}/{allPaths=**} {
      // Publicly readable avatars (safe), restrict writes to the owner
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId &&
        request.resource != null && request.resource.contentType.matches('image/.*');
    }

    // Teacher avatars stored under teacher-avatars/{uid}/...
    match /teacher-avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId &&
        request.resource != null && request.resource.contentType.matches('image/.*');
    }

    // Legacy or other avatar folder
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId &&
        request.resource != null && request.resource.contentType.matches('image/.*');
    }

    // Default: authenticated read, no write
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
